// ============================================================================
//  main_tracker.c  -  Stage C multi-target tracker on HARDWARE (ZCU102)
// ----------------------------------------------------------------------------
//  Full pipeline, offline scenario (no networking yet):
//    per epoch:  PS gate+associate+birth/death  ->  PL EKF update  ->  PS score
//  Prints periodic status and a final RMSE. If it matches the host test
//  (~26 m mature RMSE, ~5 confirmed tracks), the tracker is verified on silicon.
//
//  App src/: main_tracker.c, track_mgr.c, track_mgr.h, sensor_models.c/.h, scenario2.h
//  (one main at a time - remove main_scenario.c / smoke-test main.c)
// ============================================================================
#include <stdio.h>
#include <math.h>
#include "xparameters.h"
#include "xekf_batch.h"
#include "xil_cache.h"
#include "xil_printf.h"
#include "xstatus.h"
#include "track_mgr.h"
#include "scenario3.h"

static float data_buf[TM_MAXTRK * TM_STRIDE] __attribute__((aligned(64)));
static int   nmeas_buf[TM_MAXTRK]            __attribute__((aligned(64)));
static int   slot2trk[TM_MAXTRK];
static TrackMgr TM;
static XEkf_batch Ekf;

static int ekf_init(void) {
    XEkf_batch_Config *cfg = XEkf_batch_LookupConfig(XPAR_XEKF_BATCH_0_DEVICE_ID);
    if (!cfg || XEkf_batch_CfgInitialize(&Ekf, cfg) != XST_SUCCESS) {
        xil_printf("ERROR: driver init failed\r\n"); return XST_FAILURE;
    }
    return XST_SUCCESS;
}

#define IP_WAVE 100    // the IP processes up to 100 tracks per invocation

// Run all active tracks through the fabric in waves of <=100 (the IP's capacity).
// Tracks are independent, so N tracks = ceil(N/100) back-to-back IP calls.
static void run_ip(int ntrk) {
    if (ntrk <= 0) return;
    Xil_DCacheFlushRange((UINTPTR)data_buf,  sizeof(data_buf));
    Xil_DCacheFlushRange((UINTPTR)nmeas_buf, sizeof(nmeas_buf));
    for (int off = 0; off < ntrk; off += IP_WAVE) {
        int c = ntrk - off; if (c > IP_WAVE) c = IP_WAVE;
        XEkf_batch_Set_data(&Ekf,       (u64)(UINTPTR)&data_buf[off * TM_STRIDE]);
        XEkf_batch_Set_nmeas(&Ekf,      (u64)(UINTPTR)&nmeas_buf[off]);
        XEkf_batch_Set_num_tracks(&Ekf, (u32)c);
        XEkf_batch_Start(&Ekf);
        while (!XEkf_batch_IsDone(&Ekf)) { }
    }
    Xil_DCacheInvalidateRange((UINTPTR)data_buf, sizeof(data_buf));
}

int main(void) {
    xil_printf("\r\n==== EKF multi-target tracker (hardware) ====\r\n");
    if (ekf_init() != XST_SUCCESS) return -1;
    tm_init(&TM);

    double sq_mat=0; long mat_n=0, matched=0, truth_tot=0, false_tot=0;

    for (int e=0; e<S2_NEPOCH; e++) {
        const float *rd=&s2_radar_det[e*S2_MAXDET*3]; int nr=s2_radar_ndet[e];
        const float *id=&s2_irst_det [e*S2_MAXDET*2]; int ni=s2_irst_ndet[e];
        const float *wd=&s2_rwr_det  [e*S2_MAXDET*2]; int nw=s2_rwr_ndet[e];

        tm_begin_epoch(&TM);
        tm_associate(&TM, rd, nr, id, ni, wd, nw);
        int np = tm_build_batch(&TM, data_buf, nmeas_buf, slot2trk);
        run_ip(np);                                  // <-- fabric does the EKF
        tm_finish_epoch(&TM, data_buf, slot2trk, np);

        if (e < 30) continue;
        int ntgt=s2_ntgt[e], conf=tm_count(&TM, TM_CONFIRMED);
        truth_tot += ntgt;
        char tm_[S2_MAXTGT]={0};
        for (int i=0;i<TM_MAXTRK;i++) {
            if (TM.t[i].status!=TM_CONFIRMED) continue;
            int best=-1; float bd2=1e18f;
            for (int g=0; g<ntgt; g++) {
                const float *tp=&s2_truth[(e*S2_MAXTGT+g)*3];
                float dx=TM.t[i].x[0]-tp[0], dy=TM.t[i].x[1]-tp[1], dz=TM.t[i].x[2]-tp[2];
                float d2=dx*dx+dy*dy+dz*dz; if (d2<bd2){bd2=d2;best=g;}
            }
            if (best>=0 && bd2 < 1000.0f*1000.0f) {
                if (!tm_[best]) { tm_[best]=1; matched++; if (TM.t[i].age>=25){sq_mat+=bd2;mat_n++;} }
            } else false_tot++;
        }
        if (e % 20 == 0)
            xil_printf("  epoch %3d : true=%d  confirmed=%d\r\n", e, ntgt, conf);
    }

    double rmse = sqrt(sq_mat/(double)(mat_n>0?mat_n:1));
    int rmse_cm=(int)(rmse*100.0);
    int hold = (int)(100.0*matched/(truth_tot>0?truth_tot:1));
    xil_printf("\r\n  target hold rate   = %d %%\r\n", hold);
    xil_printf("  mature-track RMSE  = %d.%02d m   (host ref ~ 25.7 m)\r\n", rmse_cm/100, rmse_cm%100);
    xil_printf("  false tracks       = %ld\r\n", false_tot);
    xil_printf("  RESULT: %s\r\n", (rmse<60.0 && hold>90) ? "PASS - tracker verified on hardware"
                                                          : "REVIEW");
    xil_printf("==== tracker complete ====\r\n");
    return 0;
}

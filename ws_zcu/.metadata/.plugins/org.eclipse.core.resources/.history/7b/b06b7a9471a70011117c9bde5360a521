// ============================================================================
//  main_scenario.c  -  Stage B: multi-epoch fusion on HARDWARE (ZCU102)
// ----------------------------------------------------------------------------
//  The real fusion loop, offline (no networking yet): each epoch the PS
//  linearizes every track (sensor_models.c), the PL fabric runs the EKF, and
//  the PS scores the fused tracks against truth. If the RMSE matches the host
//  test (~14 m), the PS+PL pipeline is verified end-to-end on silicon.
//
//  Add to a standalone Application (psu_cortexa53_0) together with:
//      sensor_models.c, sensor_models.h, scenario.h
//  (Replaces main.c from the smoke test - use one main at a time.)
// ============================================================================
#include <stdio.h>
#include <math.h>
#include "xparameters.h"
#include "xekf_batch.h"
#include "xil_cache.h"
#include "xil_printf.h"
#include "xstatus.h"
#include "sensor_models.h"
#include "scenario.h"

static float data_buf[SCN_NTRK * SM_STRIDE] __attribute__((aligned(64)));
static int   nmeas_buf[SCN_NTRK]            __attribute__((aligned(64)));
static float x_state[SCN_NTRK * 6];
static float P_state[SCN_NTRK * 36];

static XEkf_batch Ekf;

static int ekf_init(void) {
    XEkf_batch_Config *cfg = XEkf_batch_LookupConfig(XPAR_XEKF_BATCH_0_DEVICE_ID);
    if (!cfg || XEkf_batch_CfgInitialize(&Ekf, cfg) != XST_SUCCESS) {
        xil_printf("ERROR: driver init failed\r\n"); return XST_FAILURE;
    }
    return XST_SUCCESS;
}

// run one epoch's batch through the fabric
static void run_ip(void) {
    Xil_DCacheFlushRange((UINTPTR)data_buf,  sizeof(data_buf));
    Xil_DCacheFlushRange((UINTPTR)nmeas_buf, sizeof(nmeas_buf));
    XEkf_batch_Set_data(&Ekf,       (u64)(UINTPTR)data_buf);
    XEkf_batch_Set_nmeas(&Ekf,      (u64)(UINTPTR)nmeas_buf);
    XEkf_batch_Set_num_tracks(&Ekf, (u32)SCN_NTRK);
    XEkf_batch_Start(&Ekf);
    while (!XEkf_batch_IsDone(&Ekf)) { }
    Xil_DCacheInvalidateRange((UINTPTR)data_buf, sizeof(data_buf));
}

int main(void) {
    xil_printf("\r\n==== EKF multi-epoch scenario (hardware) ====\r\n");
    if (ekf_init() != XST_SUCCESS) return -1;

    for (int t = 0; t < SCN_NTRK; t++) {
        for (int i = 0; i < 6;  i++) x_state[t*6 + i]  = scn_x0[t*6 + i];
        for (int i = 0; i < 36; i++) P_state[t*36 + i] = scn_P0[i];
    }

    double sq_sum = 0.0; long cnt = 0;
    for (int e = 0; e < SCN_NEPOCH; e++) {
        // PS: linearize every track into the DDR batch
        for (int t = 0; t < SCN_NTRK; t++) {
            const float *rz = &scn_radar_z[(e*SCN_NTRK + t)*3];
            const float *iz = &scn_irst_z [(e*SCN_NTRK + t)*2];
            const float *wz = &scn_rwr_z  [(e*SCN_NTRK + t)*2];
            nmeas_buf[t] = sm_fill_track(&data_buf[t*SM_STRIDE],
                                         &x_state[t*6], &P_state[t*36], rz, iz, wz);
        }
        // PL: fabric runs the EKF over the batch
        run_ip();
        // PS: read back posterior, carry forward, score vs truth
        for (int t = 0; t < SCN_NTRK; t++) {
            const float *out = &data_buf[t*SM_STRIDE];
            for (int i = 0; i < 6;  i++) x_state[t*6 + i]  = out[SM_OFF_X + i];
            for (int i = 0; i < 36; i++) P_state[t*36 + i] = out[SM_OFF_P + i];
            const float *tr = &scn_truth[(e*SCN_NTRK + t)*6];
            float dx=out[0]-tr[0], dy=out[1]-tr[1], dz=out[2]-tr[2];
            if (e >= 20) { sq_sum += (double)(dx*dx+dy*dy+dz*dz); cnt++; }
        }
    }

    double rmse = sqrt(sq_sum / (double)cnt);
    int rmse_cm = (int)(rmse * 100.0);   // xil_printf has no %f
    xil_printf("fused position RMSE = %d.%02d m  (host-test ref ~ 14.18 m)\r\n",
               rmse_cm/100, rmse_cm%100);
    xil_printf("RESULT: %s\r\n", (rmse < 40.0) ? "PASS - PS+PL pipeline verified on hardware"
                                               : "FAIL - investigate");
    xil_printf("==== scenario complete ====\r\n");
    return 0;
}
